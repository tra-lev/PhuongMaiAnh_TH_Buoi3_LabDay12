@model IEnumerable<Pma_Lab05.Models.Learner>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/MyLayoutHelper.cshtml";
}

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.LearnerId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LastName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstMidName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EnrollmentDate)
            </th>
            <th>
                Major
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.LearnerId)
                </td>
                <td>
                    @Html.DisplayFor(model => item.LastName)
                </td>
                <td>
                    @Html.DisplayFor(model => item.FirstMidName)
                </td>
                <td>
                    @Html.DisplayFor(model => item.EnrollmentDate)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Major.MajorName)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.LearnerId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.LearnerId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.LearnerId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        var table = document.querySelector("table");
        table.onclick = function onTableClick() {
            table.style = "background-color: yellow;"
        }
    </script>
}
