@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/MyLayoutHelper.cshtml";
}
@model IEnumerable<Pma_Lab05.Models.Learner>

<div class="ms-2 mx-2">
    <h1>Learner List</h1>

    @await Component.InvokeAsync("Major")

    <form id="searchForm" class="d-none d-md-inline-block form-inline ms-auto me-0 me-md-3 my-2 my-md-0">
        <div class="input-group">
            <input id="keyword" class="form-control" name="keyword"
                   type="text" placeholder="Search learner" />
            <button id="btnSearch" class="btn btn-primary" type="button">
                <i class="fas fa-search"></i>
            </button>
        </div>
    </form>

    <div id="content">
        <partial name="LearnerTable" model="Model" />
    </div>

    <a asp-action="Create" class="btn btn-primary">Create New Student</a>
</div>

@section Scripts {
    <script>
        var filterUrl = "@Url.Action("LearnerFilter", "Learner")";

        function loadLearners(data) {
            $.ajax({
                url: filterUrl,
                data: data,
                success: function (response) {
                    $("div#content").html(response);
                }
            });
        }

        $('body').on('click', 'li.page-item', function (e) {
            var page = $(this).attr("page");
            var mid = $(this).attr("mid");
            var keyword = $(this).attr("keyword");
            loadLearners({ mid: mid, keyword: keyword, pageIndex: page });
        });

        $(".nav li").click(function (e) {
            var id = $(this).attr("id");
            loadLearners({ mid: id });
        });

        $("button#btnSearch").click(function (e) {
            var keyword = $("#keyword").val();
            loadLearners({ keyword: keyword });
        });

        $("form#searchForm").submit(function (e) {
            e.preventDefault();
            $("button#btnSearch").click();
        });
    </script>
}
