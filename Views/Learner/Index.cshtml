@model IEnumerable<Pma_Lab05.Models.Learner>

@{
    ViewData["Title"] = "Learner";
}

<h1 class="text-center mb-4">Learner List</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Create New
    </a>
</p>

<table class="table table-striped table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Learner ID</th>
            <th>Last Name</th>
            <th>First Name</th>
            <th>Enrollment Date</th>
            <th>Major</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.LearnerId</td>
                <td>@item.LastName</td>
                <td>@item.FirstMidName</td>
                <td>@item.EnrollmentDate.ToShortDateString()</td>
                <td>@item.Major?.MajorName</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.LearnerId"
                       class="btn btn-warning btn-sm">Edit</a>

                    <a asp-action="Details" asp-route-id="@item.LearnerId"
                       class="btn btn-info btn-sm">Details</a>

                    <a asp-action="Delete" asp-route-id="@item.LearnerId"
                       class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>